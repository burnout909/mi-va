AWS_DEFAULT_REGION=ap-northeast-2

MIVAL_HOME=/opt/mi-val
MIVAL_DATA_ROOT=/data/mi-val
MIVAL_SCRATCH_ROOT=/scratch/mi-val
MIVAL_WORKSPACE=/data/mi-val/workspaces/default

MIVAL_OMOP_CDM_S3=s3://<bucket>/Datasets/MIMIC-IV_CDM/
MIVAL_MI_CDM_EXTENSION_S3=s3://<bucket>/Datasets/MIMIC-IV_CDM/Extension/
MIVAL_DICOM_ECG_S3=s3://<bucket>/Datasets/ECG/open_datasets/MIMIC/mimic-iv-ecg-dcm/
MIVAL_PROPHECG_STEMI_S3=s3://<bucket>/Users/<user>/STEMI_JKL/BestModelSaved/

MIVAL_PROPHECG_STEMI_DIR=/data/mi-val/models/prophecg-stemi
MIVAL_ECGFOUNDER_DIR=/data/mi-val/models/ecgfounder
MIVAL_PROPHECG_ENV=/data/mi-val/envs/prophecg
MIVAL_ECGFOUNDER_ENV=/data/mi-val/envs/ecgfounder
MIVAL_DICOM_CACHE=/scratch/mi-val/dicom
MIVAL_PREPROCESSED_DIR=/scratch/mi-val/preprocessed

HF_HOME=/data/mi-val/cache/huggingface
TORCH_HOME=/data/mi-val/cache/torch
UV_CACHE_DIR=/data/mi-val/cache/uv
UV_PYTHON_INSTALL_DIR=/data/mi-val/python
TMPDIR=/scratch/mi-val/tmp
